# Stored on the server only. Never put this in a NEXT_PUBLIC variable.
ANTHROPIC_API_KEY=

# Optional overrides. Ask reasons over everything; the fast model files notes.
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# Required before the app is reachable from another device. `bun run phone`
# creates one for you if it is missing.
# APP_PASSCODE=

DB_PATH=data/memory.db
